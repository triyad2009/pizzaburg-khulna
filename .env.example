// Environment variables template
// Copy to .env.local and fill in values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pizzaburg

# Authentication
JWT_SECRET=your_jwt_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_key
CLERK_SECRET_KEY=your_clerk_secret

# Payment Processing
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Third Party APIs
SENDGRID_API_KEY=your_sendgrid_key
CLOUDINARY_URL=cloudinary://...

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS=UA_...
SENTRY_DSN=https://...

# App Configuration
NEXT_PUBLIC_APP_NAME=PizzaBurg Khulna
NEXT_PUBLIC_APP_URL=https://pizzaburg-khulna.com
NEXT_PUBLIC_TIMEZONE=Asia/Dhaka

# Feature Flags
NEXT_PUBLIC_ENABLE_BOOKING=true
NEXT_PUBLIC_ENABLE_ONLINE_ORDERING=true
NEXT_PUBLIC_ENABLE_REVIEWS=true
